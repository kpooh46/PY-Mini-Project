-- Run this file using psql from the Shoplytics project folder.
-- Expected folder layout: ./data/cleaned/<CSV files>
-- Example: psql -h localhost -p 5432 -U postgres -d shoplytics -f import_cleaned_csvs.psql

\set ON_ERROR_STOP on

\copy "olist_customers_clean" ("customer_id", "customer_unique_id", "customer_zip_code_prefix", "customer_city", "customer_state") FROM 'data/cleaned/olist_customers_clean.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
\copy "olist_geolocation_clean" ("geolocation_zip_code_prefix", "geolocation_lat", "geolocation_lng", "geolocation_city", "geolocation_state", "source_rows") FROM 'data/cleaned/olist_geolocation_clean.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
\copy "olist_order_items_clean" ("order_id", "order_item_id", "product_id", "seller_id", "shipping_limit_date", "price", "freight_value") FROM 'data/cleaned/olist_order_items_clean.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
\copy "olist_order_payments_clean" ("order_id", "payment_sequential", "payment_type", "payment_installments", "payment_value", "dq_flags") FROM 'data/cleaned/olist_order_payments_clean.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
\copy "olist_order_reviews_clean" ("review_id", "order_id", "review_score", "review_comment_title", "review_comment_message", "review_creation_date", "review_answer_timestamp", "reviews_in_raw", "low_rating_flag") FROM 'data/cleaned/olist_order_reviews_clean.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
\copy "olist_orders_clean" ("order_id", "customer_id", "order_status", "order_purchase_timestamp", "order_approved_at", "order_delivered_carrier_date", "order_delivered_customer_date", "order_estimated_delivery_date", "dq_flags", "purchase_to_approval_hours", "approval_to_carrier_hours", "carrier_to_delivery_days", "delivery_duration_days", "delivery_delay_days", "late_delivery_flag", "long_delivery_over_100d") FROM 'data/cleaned/olist_orders_clean.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
\copy "olist_products_clean" ("product_id", "product_category_name", "product_name_length", "product_description_length", "product_photos_qty", "product_weight_g", "product_length_cm", "product_height_cm", "product_width_cm", "product_category_name_english") FROM 'data/cleaned/olist_products_clean.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
\copy "olist_sellers_clean" ("seller_id", "seller_zip_code_prefix", "seller_city", "seller_state") FROM 'data/cleaned/olist_sellers_clean.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
\copy "order_items_analysis_table" ("order_id", "order_item_id", "product_id", "seller_id", "shipping_limit_date", "price", "freight_value", "product_category_name_english", "seller_city", "seller_state", "order_status", "order_purchase_timestamp", "customer_unique_id", "customer_city", "customer_state", "delivery_delay_days", "late_delivery_flag", "review_score", "low_rating_flag") FROM 'data/cleaned/order_items_analysis_table.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
\copy "orders_analysis_table" ("order_id", "customer_id", "order_status", "order_purchase_timestamp", "order_approved_at", "order_delivered_carrier_date", "order_delivered_customer_date", "order_estimated_delivery_date", "dq_flags", "purchase_to_approval_hours", "approval_to_carrier_hours", "carrier_to_delivery_days", "delivery_duration_days", "delivery_delay_days", "late_delivery_flag", "long_delivery_over_100d", "customer_unique_id", "customer_zip_code_prefix", "customer_city", "customer_state", "item_count", "item_sales_value", "freight_total", "seller_count", "payment_total", "max_installments", "main_payment_type", "review_score", "low_rating_flag") FROM 'data/cleaned/orders_analysis_table.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
\copy "product_category_name_translation_clean" ("product_category_name", "product_category_name_english") FROM 'data/cleaned/product_category_name_translation_clean.csv' WITH (FORMAT csv, HEADER true, ENCODING 'UTF8');
